{
  "manifest_version": 2,
  "name": "Aegis Blocker",
  "version": "1.0.0",
  "description": "Built-in request filtering, cosmetic element hiding, and tracking protection for Aegis Browser.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aegis-blocker@aegisbrowser.local"
    }
  }
}
